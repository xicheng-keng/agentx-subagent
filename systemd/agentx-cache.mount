# tmpfs backing cache.lmdb (docs/design.md 2.3).
# The volatile environment must vanish on every power cycle so that volatile
# MIB objects come back at their DEFVAL instead of last session's value.
[Unit]
Description=tmpfs for the AgentX subagent volatile LMDB environment

[Mount]
What=tmpfs
Where=/run/agentx-subagent
Type=tmpfs
Options=mode=0750,uid=agentx,gid=agentx,size=32M,nosuid,nodev,noexec

[Install]
WantedBy=multi-user.target
